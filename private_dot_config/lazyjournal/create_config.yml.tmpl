{{- $host := index .theme.hosts .profile -}}
# Initial configuration generated by NovaLabs dotfiles.
# Uses native named colors supported by LazyJournal 0.8.7.
# Existing configurations and subsequent user edits are preserved.

interface:
  foregroundColor: default
  backgroundColor: default
  selectedForegroundColor: black
  selectedBackgroundColor: "{{ $host.lazyjournal_accent }}"
  frameColor: default
  titleColor: default
  selectedFrameColor: "{{ $host.lazyjournal_accent }}"
  selectedTitleColor: "{{ $host.lazyjournal_accent }}"
  errorColor: red
