{{- /*
    NovaLabs Mise configuration renderer.

    Application declarations: .chezmoidata/apps.toml
    Host policy:              .chezmoidata/hosts.toml
    Profile selection:        .chezmoitemplates/apps/selection

    All application versions are intentionally pinned.
*/ -}}

{{- $root := . -}}
{{- $tools := dict -}}

{{- range $name, $app := .apps -}}

    {{- $enabled := includeTemplate "apps/selection" (dict "root" $root "app" $app) | trim -}}

    {{- if eq $enabled "true" -}}

        {{- if hasKey $app "options" -}}

            {{- $options := deepCopy $app.options -}}
            {{- $_ := set $options "version" $app.version -}}
            {{- $_ := set $tools $app.backend $options -}}

        {{- else -}}

            {{- $_ := set $tools $app.backend $app.version -}}

        {{- end -}}

    {{- end -}}

{{- end -}}
# Managed by ChezMoi for NovaLabs hosts.
# Generated from .chezmoidata/apps.toml.
# Tool versions are intentionally pinned.
# Do not edit this generated configuration directly.

{{ dict "tools" $tools | toToml -}}
